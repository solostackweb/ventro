# Ventro Environment Variables
# Copy to .env.local and fill in your values

# Supabase (create project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Analytics
NEXT_PUBLIC_GA_ID=

# Optional: Error tracking
SENTRY_DSN=

# Email (for transactional emails - Resend, SendGrid, etc.)
# EMAIL_FROM=noreply@yourdomain.com
# RESEND_API_KEY=

# Cloudflare R2 (for raw document archive)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=ventro-archive
# R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Tavily Search (gap-fill only, capped)
# TAVILY_API_KEY=

# Firecrawl (gap-fill only, capped)
# FIRECRAWL_API_KEY=

# OpenAI (for extraction/summarization - $50 credit budget)
# OPENAI_API_KEY=

# NVIDIA (preview access for model evaluation)
# NVIDIA_API_KEY=



R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ventro-archive
R2_PUBLIC_URL=https://pub-xxx.r2.dev